#!/usr/bin/env bash
# PiKiosk — lightweight kiosk display manager for Raspberry Pi
# Usage: pikiosk <command>
#
# Commands:
#   start    — launch Cage + Chromium (called from .bash_profile)
#   stop     — kill the running kiosk
#   reload   — restart with updated config
#   status   — show whether kiosk is running
#   config   — display current configuration

set -euo pipefail

CONFIG_FILE="/etc/pikiosk/config.yaml"
VERSION="0.1.0"

# --- Config parsing ---

read_config() {
    python3 -c "
import yaml, sys
with open('$CONFIG_FILE') as f:
    c = yaml.safe_load(f)

url = c.get('url', '')
if not url:
    print('Error: url is required in $CONFIG_FILE', file=sys.stderr)
    sys.exit(1)

refresh = c.get('refresh', 120)
display = c.get('display', {})
network = c.get('network', {})

# Derive wait_host from URL if not set
wait_host = network.get('wait_host', '')
if not wait_host:
    from urllib.parse import urlparse
    parsed = urlparse(url)
    wait_host = parsed.hostname or ''

wait_timeout = network.get('wait_timeout', 120)
software_render = display.get('software_render', True)

print(f\"URL='{url}'\")
print(f\"REFRESH='{refresh}'\")
print(f\"WAIT_HOST='{wait_host}'\")
print(f\"WAIT_TIMEOUT='{wait_timeout}'\")
print(f\"SOFTWARE_RENDER='{software_render}'\")
"
}

# --- Valid config keys (whitelist) ---

VALID_KEYS="url refresh display.gpu_memory display.software_render display.on display.off network.wait_host network.wait_timeout watchdog.enabled watchdog.threshold watchdog.interval"

# --- Commands ---

cmd_start() {
    # Parse config
    eval "$(read_config)" || exit 1

    # Wait for network
    if [ -n "$WAIT_HOST" ]; then
        echo "Waiting for network ($WAIT_HOST)..."
        SECONDS=0
        while ! ping -c1 -W2 "$WAIT_HOST" &>/dev/null; do
            if [ "$SECONDS" -ge "$WAIT_TIMEOUT" ]; then
                echo "Network timeout after ${WAIT_TIMEOUT}s — launching anyway"
                break
            fi
            sleep 2
        done
        echo "Network ready (${SECONDS}s)"
    fi

    # Build Chromium flags
    CHROME_FLAGS=(
        --kiosk
        --noerrdialogs
        --disable-infobars
        --disable-translate
        --no-first-run
        --disable-features=TranslateUI
        --disable-session-crashed-bubble
        --disable-component-update
        --autoplay-policy=no-user-gesture-required
    )

    if [ "$SOFTWARE_RENDER" = "True" ]; then
        CHROME_FLAGS+=(
            --disable-gpu
            --use-gl=swiftshader
            --ignore-gpu-blocklist
        )
    fi

    echo "Starting PiKiosk v${VERSION}"
    echo "  URL: $URL"
    echo "  Refresh: ${REFRESH}s"

    # Crash recovery loop — restart Cage if it exits
    while true; do
        cage -- chromium "${CHROME_FLAGS[@]}" "$URL" 2>/dev/null
        echo "Cage exited, restarting in 5s..."
        sleep 5
    done
}

cmd_stop() {
    if pgrep -x cage &>/dev/null; then
        pkill cage
        echo "Kiosk stopped"
    else
        echo "Kiosk is not running"
    fi
}

cmd_reload() {
    echo "Reloading kiosk..."
    cmd_stop
    sleep 2
    # The .bash_profile loop or TTY autologin will restart it
    echo "Kiosk will restart on next TTY1 login, or reboot to apply"
}

cmd_status() {
    echo "PiKiosk v${VERSION}"
    echo ""
    if pgrep -x cage &>/dev/null; then
        echo "Status: RUNNING"
        echo "  Cage PID: $(pgrep -x cage)"
        CHROME_PID=$(pgrep -f 'chromium.*--kiosk' | head -1 || true)
        [ -n "$CHROME_PID" ] && echo "  Chromium PID: $CHROME_PID"
    else
        echo "Status: STOPPED"
    fi
    echo ""

    # Memory usage
    free -m | awk '/^Mem/{printf "Memory: %dMB / %dMB (%.0f%%)\n", $3, $2, $3/$2*100}'
}

cmd_config() {
    if [ ! -f "$CONFIG_FILE" ]; then
        echo "Error: $CONFIG_FILE not found"
        exit 1
    fi

    echo "PiKiosk v${VERSION} — Configuration"
    echo "  Config file: $CONFIG_FILE"
    echo ""

    # Parse and display
    python3 -c "
import yaml
with open('$CONFIG_FILE') as f:
    c = yaml.safe_load(f)

print(f'  URL:             {c.get(\"url\", \"(not set)\")}')
print(f'  Refresh:         {c.get(\"refresh\", 120)}s')

d = c.get('display', {})
print(f'  GPU memory:      {d.get(\"gpu_memory\", 128)}MB')
print(f'  Software render: {d.get(\"software_render\", True)}')
on = d.get('on', '')
off = d.get('off', '')
if on and off:
    print(f'  Display hours:   {on} — {off}')
else:
    print(f'  Display hours:   always on')

n = c.get('network', {})
print(f'  Wait timeout:    {n.get(\"wait_timeout\", 120)}s')

w = c.get('watchdog', {})
if w.get('enabled', True):
    print(f'  Watchdog:        {w.get(\"threshold\", 90)}% threshold, every {w.get(\"interval\", 5)}m')
else:
    print(f'  Watchdog:        disabled')
"
}

cmd_set() {
    local key="$1"
    local value="$2"

    # Validate key against whitelist
    local valid=false
    for k in $VALID_KEYS; do
        if [ "$k" = "$key" ]; then
            valid=true
            break
        fi
    done
    if [ "$valid" = "false" ]; then
        echo "Error: unknown key '$key'"
        echo "Valid keys: $VALID_KEYS"
        exit 1
    fi

    # Require root for writing config and cron files
    if [ "$EUID" -ne 0 ]; then
        echo "Error: pikiosk set requires root (use sudo)"
        exit 1
    fi

    # Update YAML using targeted line replacement to preserve comments
    python3 -c "
import yaml, sys, re, fcntl

config_path = '$CONFIG_FILE'
key = '$key'
value = '''$value'''

# Type coerce
if value.lower() == 'true':
    value = True
elif value.lower() == 'false':
    value = False
else:
    try:
        value = int(value)
    except ValueError:
        pass  # keep as string

# Load current config
with open(config_path) as f:
    fcntl.flock(f, fcntl.LOCK_SH)
    config = yaml.safe_load(f) or {}
    raw = open(config_path).read()

# Set the value in the parsed config
parts = key.split('.')
obj = config
for p in parts[:-1]:
    if p not in obj or not isinstance(obj[p], dict):
        obj[p] = {}
    obj = obj[p]
obj[parts[-1]] = value

# Targeted line replacement in raw file to preserve comments
lines = raw.splitlines()
new_lines = []
if len(parts) == 1:
    # Top-level key
    pattern = re.compile(r'^(\s*#?\s*)' + re.escape(parts[0]) + r'\s*:.*')
    found = False
    for line in lines:
        m = pattern.match(line)
        if m and not found:
            found = True
            if isinstance(value, bool):
                val_str = str(value).lower()
            elif isinstance(value, int):
                val_str = str(value)
            else:
                val_str = '\"' + str(value) + '\"'
            new_lines.append(f'{parts[0]}: {val_str}')
        else:
            new_lines.append(line)
    if not found:
        if isinstance(value, bool):
            val_str = str(value).lower()
        elif isinstance(value, int):
            val_str = str(value)
        else:
            val_str = '\"' + str(value) + '\"'
        new_lines.append(f'{parts[0]}: {val_str}')
else:
    # Nested key (one level deep)
    parent, child = parts[0], parts[1]
    parent_pattern = re.compile(r'^' + re.escape(parent) + r'\s*:')
    child_pattern = re.compile(r'^(\s*#?\s*)' + re.escape(child) + r'\s*:.*')
    in_parent = False
    found = False
    for line in lines:
        if parent_pattern.match(line):
            in_parent = True
            new_lines.append(line)
            continue
        if in_parent and line.strip() and not line.startswith(' ') and not line.startswith('\t'):
            in_parent = False
        if in_parent and not found:
            m = child_pattern.match(line)
            if m:
                found = True
                if isinstance(value, bool):
                    val_str = str(value).lower()
                elif isinstance(value, int):
                    val_str = str(value)
                else:
                    val_str = '\"' + str(value) + '\"'
                new_lines.append(f'  {child}: {val_str}')
                continue
        new_lines.append(line)
    if not found:
        # Append under parent section
        if isinstance(value, bool):
            val_str = str(value).lower()
        elif isinstance(value, int):
            val_str = str(value)
        else:
            val_str = '\"' + str(value) + '\"'
        # Find parent and insert after it
        for i, line in enumerate(new_lines):
            if parent_pattern.match(line):
                new_lines.insert(i + 1, f'  {child}: {val_str}')
                break

with open(config_path, 'w') as f:
    fcntl.flock(f, fcntl.LOCK_EX)
    f.write('\n'.join(new_lines) + '\n')

print(f'Set {key} = {value}')
"

    # Apply side effects
    cmd_apply
}

cmd_apply() {
    if [ "$EUID" -ne 0 ]; then
        echo "Error: pikiosk apply requires root (use sudo)"
        exit 1
    fi

    # Read watchdog config
    eval "$(python3 -c "
import yaml
with open('$CONFIG_FILE') as f:
    c = yaml.safe_load(f)
w = c.get('watchdog', {})
print(f\"WATCHDOG_ENABLED='{'True' if w.get('enabled', True) else 'False'}'\")
print(f\"WATCHDOG_THRESHOLD='{w.get('threshold', 90)}'\")
print(f\"WATCHDOG_INTERVAL='{w.get('interval', 5)}'\")
d = c.get('display', {})
print(f\"DISPLAY_ON='{d.get('on', '')}'\")
print(f\"DISPLAY_OFF='{d.get('off', '')}'\")
")"

    # Watchdog cron
    CRON_FILE="/etc/cron.d/pikiosk-watchdog"
    if [ "$WATCHDOG_ENABLED" = "True" ]; then
        THRESHOLD_FRAC=$(echo "scale=2; $WATCHDOG_THRESHOLD / 100" | bc)
        cat > "$CRON_FILE" <<EOF
# PiKiosk memory watchdog — restart browser if RAM exceeds ${WATCHDOG_THRESHOLD}%
*/$WATCHDOG_INTERVAL * * * * root free -m | awk '/^Mem/{if(\$3/\$2 > $THRESHOLD_FRAC) system("pkill cage")}'
EOF
        echo "  Watchdog: ${WATCHDOG_THRESHOLD}% threshold, every ${WATCHDOG_INTERVAL}m"
    else
        rm -f "$CRON_FILE"
        echo "  Watchdog: disabled"
    fi

    # Display hours cron
    CRON_DISPLAY="/etc/cron.d/pikiosk-display"
    if [ -n "$DISPLAY_ON" ] && [ -n "$DISPLAY_OFF" ]; then
        ON_H=$(echo "$DISPLAY_ON" | cut -d: -f1)
        ON_M=$(echo "$DISPLAY_ON" | cut -d: -f2)
        OFF_H=$(echo "$DISPLAY_OFF" | cut -d: -f1)
        OFF_M=$(echo "$DISPLAY_OFF" | cut -d: -f2)
        cat > "$CRON_DISPLAY" <<EOF
# PiKiosk display hours — HDMI-CEC power control
$ON_M $ON_H * * * root echo "on 0" | cec-client -s -d 1
$OFF_M $OFF_H * * * root echo "standby 0" | cec-client -s -d 1
EOF
        echo "  Display hours: $DISPLAY_ON — $DISPLAY_OFF"
    else
        rm -f "$CRON_DISPLAY"
        echo "  Display hours: always on"
    fi

    echo "  Config applied"
}

cmd_admin() {
    exec python3 /usr/local/lib/pikiosk/admin.py "$@"
}

# --- Main ---

case "${1:-}" in
    start)   cmd_start ;;
    stop)    cmd_stop ;;
    reload)  cmd_reload ;;
    status)  cmd_status ;;
    config)  cmd_config ;;
    set)     cmd_set "${2:-}" "${3:-}" ;;
    apply)   cmd_apply ;;
    admin)   shift; cmd_admin "$@" ;;
    version) echo "PiKiosk v${VERSION}" ;;
    *)
        echo "PiKiosk v${VERSION} — Kiosk display manager for Raspberry Pi"
        echo ""
        echo "Usage: pikiosk <command>"
        echo ""
        echo "Commands:"
        echo "  start              Launch kiosk (called automatically on boot)"
        echo "  stop               Stop the kiosk display"
        echo "  reload             Restart with updated config"
        echo "  status             Show kiosk status and resource usage"
        echo "  config             Display current configuration"
        echo "  set <key> <value>  Update a config setting (requires sudo)"
        echo "  apply              Apply config changes (cron jobs, etc.)"
        echo "  admin              Start the web admin UI"
        echo "  version            Show version"
        ;;
esac
